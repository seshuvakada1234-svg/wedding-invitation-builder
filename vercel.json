{
  "version": 2,
  "functions": {
    "server.ts": {
      "runtime": "nodejs18.x"
    },
    "api/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
