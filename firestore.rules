rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || (request.auth.token.email != null && resource.data.email == request.auth.token.email));
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email in [
          "resumepro.ads@gmail.com",
          "seshuvakada1234@gmail.com"
        ]
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Invite Validation ---
    function isValidInvite(data) {
      return (data.userId == request.auth.uid || isAdmin() || (data.email != null && data.email == request.auth.token.email))
        && (data.brideName == null || (data.brideName is string && data.brideName.size() <= 200))
        && (data.groomName == null || (data.groomName is string && data.groomName.size() <= 200))
        && (data.weddingDate == null || (data.weddingDate is string && data.weddingDate.size() <= 200))
        && (data.location == null || (data.location is string && data.location.size() <= 1000))
        && (data.template == null || (data.template is string && data.template.size() <= 200))
        && (data.templateId == null || (data.templateId is string && data.templateId.size() <= 200))
        && (data.views == null || (data.views is number && data.views >= 0))
        && (data.viewsLimit == null || (data.viewsLimit is number && data.viewsLimit >= 0))
        && (data.viewsUsed == null || (data.viewsUsed is number && data.viewsUsed >= 0))
        && (data.viewLimit == null || (data.viewLimit is number && data.viewLimit >= 0))
        && (data.slug == null || (data.slug is string && data.slug.size() <= 256))
        && (data.isPaid == null || data.isPaid is bool)
        && (data.galleryImages == null || data.galleryImages is list)
        && (data.galleryImageKeys == null || data.galleryImageKeys is list)
        && (data.events == null || data.events is list)
        && (data.createdAt == null || data.createdAt is string || data.createdAt is timestamp)
        && (data.updatedAt == null || data.updatedAt is string || data.updatedAt is timestamp)
        && (data.publishedAt == null || data.publishedAt is string || data.publishedAt is timestamp)
        && (data.status == null || data.status is string)
        && (data.published == null || data.published is bool)
        && (data.draftData == null || data.draftData is map)
        && (data.publishedData == null || data.publishedData is map)
        && (data.templateDrafts == null || data.templateDrafts is map)
        && (data.deployCount == null || data.deployCount is number)
        && (data.redeployCount == null || data.redeployCount is number)
        && (data.imageCount == null || data.imageCount is number);
    }

    // --- Collection: Invites ---
    match /invites/{inviteId} {
      // get is public so anyone can view an invite if they have the ID/slug
      allow get: if true;

      // list is restricted to signed-in users.
      allow list: if isSignedIn();

      allow create: if isSignedIn() 
        && isValidId(inviteId)
        && (
          isAdmin() || (
            (incoming().userId == request.auth.uid || incoming().email == request.auth.token.email)
            && (incoming().isPaid == null || incoming().isPaid == false)
            && (incoming().views == null || incoming().views == 0)
          )
        );

      allow update: if isSignedIn() && (
        isAdmin() || 
        (existing().userId == request.auth.uid || existing().email == request.auth.token.email)
      );

      allow delete: if isAdmin() || (isSignedIn() && (existing().userId == request.auth.uid || existing().email == request.auth.token.email));
    }
    
    // --- Collection: Admins ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Firebase Console / Cloud Functions
    }

    // --- Collection: Users ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Managed by Backend Admin SDK
    }

    // --- Collection: Payments ---
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false; // Managed by Backend Admin SDK
    }

    // --- Collection: Templates ---
    match /templates/{templateId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          "resumepro.ads@gmail.com",
          "seshuvakada1234@gmail.com"
        ];
    }

    // --- Collection: Settings ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          "resumepro.ads@gmail.com",
          "seshuvakada1234@gmail.com"
        ];
    }

    // --- Collection: AdminImages ---
    match /adminImages/{imageId} {
      allow read, write: if isAdmin();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
    }

    // --- Collection: UploadedImages ---
    match /uploadedImages/{imageId} {
      allow read, write: if isAdmin();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
    }
  }
}
