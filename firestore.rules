rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email in [
          "resumepro.ads@gmail.com",
          "seshuvakada1234@gmail.com"
        ]
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Invite Validation ---
    function isValidInvite(data) {
      return data.userId == request.auth.uid 
        && data.brideName is string && data.brideName.size() <= 100
        && data.groomName is string && data.groomName.size() <= 100
        && data.weddingDate is string && data.weddingDate.size() <= 100
        && data.location is string && data.location.size() <= 200
        && data.template in ['beach', 'royal', 'minimal', 'royal-wedding', 'konaseema', 'kerala-wedding', 'kerala-envelope-reveal', 'housewarming-south']
        && data.views is number && data.views >= 0
        && data.viewLimit is number && data.viewLimit >= 0
        && data.slug is string && data.slug.size() <= 128
        && (data.isPaid == null || data.isPaid is bool)
        && (data.galleryImages == null || data.galleryImages is list)
        && (data.galleryImageKeys == null || data.galleryImageKeys is list)
        && (data.events == null || data.events is list)
        && (data.createdAt == null || data.createdAt is string || data.createdAt is timestamp)
        && (data.updatedAt == null || data.updatedAt is string || data.updatedAt is timestamp);
    }

    // --- Collection: Invites ---
    match /invites/{inviteId} {
      allow get: if true;

      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);

      // ✅ FIXED CREATE RULE
      allow create: if isSignedIn() 
        && isValidId(inviteId)
        && isValidInvite(incoming())
        && (incoming().isPaid == false || isAdmin())
        && (incoming().views == 0 || isAdmin());

      allow update: if isSignedIn() && isValidInvite(incoming());

      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().userId));
    }
    
    // --- Collection: Admins ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Firebase Console / Cloud Functions
    }

    // --- Collection: Users ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Managed by Backend Admin SDK
    }

    // --- Collection: Payments ---
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false; // Managed by Backend Admin SDK
    }

    // --- Collection: Templates ---
    match /templates/{templateId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          "resumepro.ads@gmail.com",
          "seshuvakada1234@gmail.com"
        ];
    }

    // --- Collection: Settings ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          "resumepro.ads@gmail.com",
          "seshuvakada1234@gmail.com"
        ];
    }
  }
}
