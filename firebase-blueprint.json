{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile and payment status",
      "type": "object",
      "properties": {
        "paid": { "type": "boolean" },
        "email": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "invite": {
      "title": "Wedding Invite",
      "description": "Details for a wedding invitation website with draft/publish separation",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "id": { "type": "string" },
        "templateId": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "live"] },
        "published": { "type": "boolean" },
        "hasUnpublishedChanges": { "type": "boolean" },
        "viewsUsed": { "type": "number" },
        "viewsLimit": { "type": "number" },
        "draftData": { "type": "object" },
        "publishedData": { "type": "object" },
        "templateDrafts": { "type": "object" },
        "brideName": { "type": "string" },
        "groomName": { "type": "string" },
        "weddingDate": { "type": "string" },
        "location": { "type": "string" },
        "updatedAt": { "type": "string" },
        "publishedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles and payment state"
    },
    "/invites/{inviteId}": {
      "schema": "invite",
      "description": "Collection of wedding invitation sites"
    }
  }
}
